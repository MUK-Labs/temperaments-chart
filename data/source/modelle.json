{
  "title": "Ideale Rechenmodelle; keine persönlichen Komponistenstimmungen",
  "reference": "C = 0 Cent; Oktave = 1200 Cent; idealisierte Tonhöhen, ohne Inharmonizität oder Stimmfehler",
  "formulae": {
    "ratio_to_cents": "c(r) = 1200 log2(r)",
    "syntonic_comma": "S = 1200 log2(81/80)",
    "pythagorean_comma": "P = 1200 log2((3/2)^12 / 2^7)",
    "meantone_generator": "g = 1200 log2(3/2) - a S; a = 1/4 oder 2/7",
    "meantone_pitch": "p_i = ((i - 3) g) mod 1200 für die gespeicherte Kette",
    "interval": "I(x,y) = (p_y - p_x) mod 1200",
    "edo12_pitch": "p_n = 100 n für die gespeicherte chromatische Tastenfolge",
    "werckmeister_iii": "C–G, G–D, D–A und H–Fis: g = 1200 log2(3/2) - P/4; übrige Kreisquinten rein"
  },
